# openUF: the hardware profile to run as, the UniFi device to present, and the
# runtime options. Every option's meaning is in USAGE.md; the full section
# reference (custom device maps, custom identities) is at the top of
# /usr/lib/openuf/uciconf.lua.

config openuf 'main'
	# auto = the shipped profile that declares this board (setup.sh's own
	# match), a profile name from /usr/lib/openuf/modelmap/, or 'custom'.
	option modelmap 'auto'
	# auto = the profile's choice (a U6-InWall), a name from
	# /usr/lib/openuf/ufmodel/, or 'custom'.
	option ufmodel 'auto'
	# Used until the controller (or `openuf set-inform`) names another.
	option inform_url 'http://unifi:8080/inform'
	option use_only_unifi_wlan '1'
	option l2_announce '1'
	option neighbour_scan_interval '0'
	option rrm_enrichment '1'
	option rrm_request_interval '600'
	option roam_assist_diff_db '8'
	# Third-party plugins from /etc/openuf/plugins/<name>.lua, one per line
	# (root-level code: list only what you have read; USAGE.md "Plugins").
	# An installer uses /etc/openuf/plugins.enabled instead; both count.
	# list plugin 'name'

# The device's web page. Its own section on purpose: a `main` section is what
# tells openUF that UCI, not conf.lua, describes the device.
config web 'web'
	# 1: the device's address opens openUF's page (status, and the settings
	# behind the root password); LuCI is one step away from there. 0: the
	# address opens LuCI as on any OpenWrt device. Needs luci-app-openuf.
	option portal '1'


#!/usr/bin/ucode

'use strict';

import { popen, access, glob, readfile } from 'fs';
import { cursor } from 'uci';

// Everything about the configuration comes from the daemon's own probe
// (`openuf probe`, hook/probe.lua): which preset `auto` resolved to, what a
// custom map came out as, the identity in play, what the board says about
// itself. The UI never re-derives it.
function probe(what) {
	const fd = popen('/usr/bin/openuf probe ' + what + ' 2>/dev/null', 'r');
	if (!fd)
		return null;
	const out = fd.read('all');
	fd.close();
	let doc = null;
	try {
		doc = json(out);
	}
	catch (e) {
		doc = null;
	}
	return (type(doc) == 'object') ? doc : null;
}

function run(cmd) {
	const fd = popen(cmd + ' 2>&1', 'r');
	if (!fd)
		return { code: 127, output: 'cannot run ' + cmd };
	const output = fd.read('all');
	const code = fd.close();
	return { code: code, output: output };
}

function shell_ok(cmd) {
	return run(cmd + ' >/dev/null').code == 0;
}

function shellquote(s) {
	return "'" + replace(s, "'", "'\\''") + "'";
}

function kmod(name) {
	return length(glob('/lib/modules/*/' + name + '.ko')) > 0;
}

const IPV4 = /^([0-9]{1,3}\.){3}[0-9]{1,3}$/;

// What openUF needs installed, from `openuf deps --check`
// (hook/openuf-deps.sh): the hostapd build -- full or basic, and the one
// thing the package cannot pull in by itself -- and every package with what
// it unlocks. Never throws: a command that is not there reads as unknown.
function deps_state() {
	const r = run('/usr/bin/openuf deps --check');
	let doc = null;
	if (r.code == 0) {
		try { doc = json(r.output); } catch (e) { doc = null; }
	}
	if (type(doc) == 'object')
		return doc;
	return { wpad: { installed: null, full: null, suggested: null, choices: [] },
	         packages: [], missing: [], ok: null,
	         error: trim(r.output) || '`openuf deps --check` produced nothing' };
}

// openuf-convert --check, parsed. Never throws: an absent command reads as
// "unknown", which the UI shows as such rather than as "router".
function convert_state() {
	if (!access('/usr/sbin/openuf-convert', 'x'))
		return { state: 'unknown', reasons: [ 'openuf-convert is not installed' ], converted: null };
	const r = run('/usr/sbin/openuf-convert --check');
	let doc = null;
	try {
		doc = json(r.output);
	}
	catch (e) {
		doc = null;
	}
	return (type(doc) == 'object') ? doc : { state: 'unknown', reasons: [ trim(r.output) ], converted: null };
}

// A reboot a few seconds after the reply has gone out, so the UI can say so.
function reboot_soon() {
	popen('(sleep 4; reboot) >/dev/null 2>&1 &', 'r');
}

// The controller's host, from an inform URL: what the portal names in "manage
// this device from ...". Host only, never the path or credentials.
function inform_host(url) {
	const m = match(url ?? '', /^[a-zA-Z]+:\/\/(\[[0-9a-fA-F:.]+\]|[^\/:?#@]+)(:([0-9]+))?/);
	return m ? { host: m[1], port: m[3] ? int(m[3]) : null } : null;
}

function first_line(path) {
	const s = readfile(path);
	return s ? trim(split(s, '\n')[0]) : null;
}

// What the locked portal shows to anyone who opens the device's address,
// before any login: the facts this AP already broadcasts in its UniFi
// discovery packets (model, MAC, address, firmware) plus where it is managed
// from, which is the point of the page. No SSIDs, no keys, no configuration.
// Cached for a few seconds: this is callable without a session, and every
// fresh answer costs a `openuf probe status` run.
let public_cache = null, public_at = 0;
function public_status() {
	if (public_cache && (time() - public_at) < 5)
		return public_cache;

	const s = probe('status') ?? {};
	const st = s.state ?? {}, h = s.health ?? {}, id = s.identity ?? {};
	const sys = cursor().get_all('system', '@system[0]') ?? {};
	const up = first_line('/proc/uptime');
	const url = st.inform_url ?? s.config?.inform_url;
	const ctl = inform_host(url);

	public_cache = {
		hostname: sys.hostname ?? null,
		model: first_line('/tmp/sysinfo/model'),
		board: s.board ?? first_line('/tmp/sysinfo/board_name'),
		presented: { model: id.model ?? null, title: id.title ?? null },
		mac: st.mac ?? h.mac ?? null,
		version: s.version ?? null,
		adopted: (st.adopted == true || h.adopted == 'true'),
		controller: ctl ? { host: ctl.host, port: ctl.port } : null,
		last_contact: h.last_ok ?? null,
		last_failure: h.last_fail ?? null,
		now: s.now ?? time(),
		uptime: up ? int(split(up, ' ')[0]) : null,
		running: shell_ok('/etc/init.d/openuf running')
	};
	public_at = time();
	return public_cache;
}

const methods = {
	getPublic: {
		call: function() {
			return public_status();
		}
	},

	getStatus: {
		call: function() {
			let s = probe('status');
			if (!s)
				s = { config_error: '`openuf probe status` produced nothing: is the openuf package installed?' };
			s.service = {
				running: shell_ok('/etc/init.d/openuf running'),
				enabled: shell_ok('/etc/init.d/openuf enabled')
			};
			s.deps = deps_state();
			s.convert = convert_state();
			return s;
		}
	},

	listPresets: {
		call: function() {
			return probe('presets') || { modelmaps: [], ufmodels: [] };
		}
	},

	discover: {
		call: function() {
			return probe('discover') || { error: '`openuf probe discover` produced nothing' };
		}
	},

	exportPreset: {
		call: function() {
			return probe('export') || { error: '`openuf probe export` produced nothing' };
		}
	},

	getConvertState: {
		call: function() {
			return convert_state();
		}
	},

	// Convert to an access point and reboot. The arguments are validated here
	// again (the script validates too) because they are interpolated into a
	// command line.
	convert: {
		args: { address: 'dhcp', gateway: '', dns: '', keep_wan_socket: false },
		call: function(request) {
			const a = request.args;
			const address = a.address || 'dhcp';
			if (address != 'dhcp' && !match(address, /^([0-9]{1,3}\.){3}[0-9]{1,3}\/[0-9]{1,2}$/))
				return { code: 2, output: 'address must be dhcp or <ip>/<prefix>' };
			if (a.gateway && !match(a.gateway, IPV4))
				return { code: 2, output: 'bad gateway' };
			for (let d in split(trim(a.dns || ''), /\s+/))
				if (d != '' && !match(d, IPV4))
					return { code: 2, output: 'bad DNS server: ' + d };
			let cmd = '/usr/sbin/openuf-convert --convert --address ' + shellquote(address);
			if (a.gateway)
				cmd += ' --gateway ' + shellquote(a.gateway);
			if (trim(a.dns || '') != '')
				cmd += ' --dns ' + shellquote(trim(a.dns));
			if (a.keep_wan_socket)
				cmd += ' --keep-wan-socket';
			const r = run(cmd);
			if (r.code == 0)
				reboot_soon();
			return r;
		}
	},

	revert: {
		call: function() {
			const r = run('/usr/sbin/openuf-convert --revert');
			if (r.code == 0)
				reboot_soon();
			return r;
		}
	}
};

return { 'luci.openuf': methods };
